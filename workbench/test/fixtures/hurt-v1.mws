[rule]
part=arp
from=sp:"Guitar 2"
ring_max_bars=1.5

[rule]
part=keys
from=sp:"Piano"
ring_max_bars=1

[rule]
part=bass
from=sp:"Bass"
fold_below=26

[rule]
part=vocal
from=sp:"Lead Vocals"

[rule]
part=pad
from=sp:"Synth 2"

[rule]
part=pad
from=sp:"Synth 1"

[rule]
part=drive
from=sp:"Guitar 1"

[rule]
part=lead
from=sp:"Synth 3"

[rule]
part=toms
from=sp:"Drums"
notes=41,45,47

[rule]
part=wash
from=sp:"FX"

[rule]
part=stick
from=sp:"Drums"
notes=37
transpose=44

[curve]
